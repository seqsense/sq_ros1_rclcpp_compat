# CMake function to generate ROS 2-style compatibility headers for ROS 1 messages.
# Exported via CFG_EXTRAS so it's available to downstream catkin packages.
#
# Usage:
#   find_package(catkin REQUIRED COMPONENTS sq_ros1_rclcpp_compat)
#   generate_ros1_compat_headers(
#     PACKAGE my_msgs
#     MSG_DIR "${CMAKE_CURRENT_SOURCE_DIR}/msg"
#     OUTPUT_DIR "${CATKIN_DEVEL_PREFIX}/include"
#   )

# catkin configures this template once per space. The devel space runs the
# script from the source tree; the install space runs the copy installed next
# to this file.
if(@DEVELSPACE@)
  set(_sq_ros1_rclcpp_compat_header_script
      "@CMAKE_CURRENT_SOURCE_DIR@/cmake/generate_ros1_compat_header.py")
else()
  set(_sq_ros1_rclcpp_compat_header_script
      "${CMAKE_CURRENT_LIST_DIR}/generate_ros1_compat_header.py")
endif()

function(generate_ros1_compat_headers)
  cmake_parse_arguments(ARG "" "PACKAGE;MSG_DIR;OUTPUT_DIR" "" ${ARGN})

  if(NOT ARG_PACKAGE)
    message(FATAL_ERROR "generate_ros1_compat_headers: PACKAGE is required")
  endif()
  if(NOT ARG_MSG_DIR)
    message(FATAL_ERROR "generate_ros1_compat_headers: MSG_DIR is required")
  endif()
  if(NOT ARG_OUTPUT_DIR)
    message(FATAL_ERROR "generate_ros1_compat_headers: OUTPUT_DIR is required")
  endif()

  # Collect message names from .msg files
  file(GLOB _msg_files RELATIVE "${ARG_MSG_DIR}" "${ARG_MSG_DIR}/*.msg")
  set(_msg_names "")
  foreach(_msg_file ${_msg_files})
    get_filename_component(_msg_name "${_msg_file}" NAME_WE)
    list(APPEND _msg_names "${_msg_name}")
  endforeach()

  if(NOT _msg_names)
    message(WARNING "generate_ros1_compat_headers: no .msg files found in ${ARG_MSG_DIR}")
    return()
  endif()

  execute_process(
    COMMAND "${PYTHON_EXECUTABLE}" "${_sq_ros1_rclcpp_compat_header_script}"
      --package "${ARG_PACKAGE}"
      --output-dir "${ARG_OUTPUT_DIR}"
      --messages ${_msg_names}
    RESULT_VARIABLE _result
  )
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "generate_ros1_compat_headers: script failed with code ${_result}")
  endif()
endfunction()
