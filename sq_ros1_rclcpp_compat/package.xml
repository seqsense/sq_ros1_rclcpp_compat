<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sq_ros1_rclcpp_compat</name>
  <version>0.0.1</version>
  <description>ROS 2 rclcpp API shim for ROS 1 (Logger, Clock, RCLCPP_INFO macros backed by spdlog). No-op on ROS 2.</description>
  <maintainer email="hatao.jsk@gmail.com">Naotaka Hatao</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>cmake</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <depend condition="$ROS_VERSION == 1">spdlog</depend>

  <test_depend condition="$ROS_VERSION == 1">rostest</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ament_lint_auto</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ament_lint_common</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ament_cmake_clang_format</test_depend>

  <export>
    <!-- catkin_make_isolated (used by ros-abuild) does not evaluate the
         condition attribute and simply reads the first build_type export, so
         the ROS 1 entry must be present and listed first. -->
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
